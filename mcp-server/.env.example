# Server
PORT=3000
ANKI_REGISTRY_PATH=./data/device-registry.json

# Development mode: all authenticated MCP calls resolve to this account
# Do not use this in multi-user production.
ANKI_DEV_ACCOUNT_ID=local-dev

# Multi-user prototype mode. JSON object mapping bearer tokens to account IDs.
# Remove ANKI_DEV_ACCOUNT_ID when using this.
# ANKI_ACCOUNT_TOKENS={"replace-with-secret-token":"account-123"}
