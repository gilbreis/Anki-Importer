# Server
PORT=3000
ANKI_REGISTRY_PATH=./data/device-registry.json

# Public HTTPS origin used to generate one-click pairing links.
# Example: https://anki-importer.example.com
ANKI_PUBLIC_BASE_URL=https://anki-importer.example.com

# Optional override for the end-user Windows installer shown on the connection page.
# Defaults to the latest GitHub Release asset when omitted.
# ANKI_INSTALLER_URL=https://github.com/gilbreis/Anki-Importer/releases/latest/download/AnkiImporterSetup.exe

# Development mode: all authenticated MCP calls resolve to this account.
# Do not use this in multi-user production.
ANKI_DEV_ACCOUNT_ID=local-dev

# Multi-user prototype mode. JSON object mapping bearer tokens to account IDs.
# Remove ANKI_DEV_ACCOUNT_ID when using this.
# ANKI_ACCOUNT_TOKENS={"replace-with-secret-token":"account-123"}
